{
  "name": "@code-trail/web",
  "version": "1.7.0",
  "description": "Code Trail browser UI (React + Monaco), built as static assets. (Code Trail 브라우저 화면)",
  "author": "최흥배 (Choi HeungBae)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jacking75/code-trail.git",
    "directory": "packages/web"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@code-trail/shared": "1.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
