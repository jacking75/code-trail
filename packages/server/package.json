{
  "name": "@code-trail/server",
  "version": "1.7.0",
  "description": "Code Trail local server: HTTP/WebSocket API, trail store, LSP client. (Code Trail 로컬 서버)",
  "author": "최흥배 (Choi HeungBae)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jacking75/code-trail.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@code-trail/shared": "1.7.0",
    "@code-trail/web": "1.7.0",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "vscode-jsonrpc": "^9.0.3",
    "vscode-languageserver-protocol": "3.18.4",
    "vscode-uri": "^3.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
