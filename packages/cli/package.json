{
  "name": "code-trail",
  "version": "1.7.0",
  "description": "Code reading trails — expand a function inline, click an identifier, and its definition nests underneath. Reads code via LSP; never edits. (코드를 읽어 내려간 경로를 트리로 남기는 로컬 도구)",
  "author": "최흥배 (Choi HeungBae)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "code-trail": "dist/main.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "call hierarchy",
    "call graph",
    "code navigation",
    "code reading",
    "lsp",
    "trail",
    "code review",
    "code understanding",
    "language server",
    "clangd",
    "gopls",
    "rust-analyzer",
    "roslyn",
    "typescript",
    "cpp",
    "csharp",
    "go",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jacking75/code-trail.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jacking75/code-trail#readme",
  "bugs": {
    "url": "https://github.com/jacking75/code-trail/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@code-trail/server": "1.7.0",
    "@code-trail/shared": "1.7.0"
  }
}
