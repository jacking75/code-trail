{
  "name": "@code-trail/shared",
  "version": "1.8.0",
  "description": "Code Trail shared domain types and protocol schemas. (Code Trail 공용 도메인 타입과 프로토콜 스키마)",
  "author": "최흥배 (Choi HeungBae)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jacking75/code-trail.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "access": "public"
  }
}
