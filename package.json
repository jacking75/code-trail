{
  "name": "code-trail-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Code Trail 작업 공간. 배포하는 것은 packages/cli 의 code-trail 이다.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacking75/code-trail.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "npm run build -w @code-trail/shared && npm run build -w @code-trail/server && npm run build:lib -w @code-trail/web && npm run build -w @code-trail/web && npm run build -w code-trail",
    "dev": "npm run dev -w @code-trail/web",
    "start": "node packages/cli/dist/main.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test \"test/unit/*.test.mjs\" && node --test \"test/integration/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:integration": "node --test \"test/integration/*.test.mjs\"",
    "test:e2e": "node test/e2e/shell.e2e.mjs && node test/e2e/trail.e2e.mjs",
    "test:lsp": "node test/smoke/real-lsp.mjs",
    "test:perf": "node test/perf/board-1000.mjs",
    "test:pack": "node test/pack/files.test.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "test:install": "node test/pack/install-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "playwright": "^1.62.1",
    "typescript": "^5.4.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.14"
    }
  }
}
