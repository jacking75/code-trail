{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "clear": true
      },
      "detail": "src/*.ts → out/*.js (F5의 preLaunchTask)"
    },
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "never"
      },
      "detail": "tsc --watch. 켜두면 저장할 때마다 out/ 갱신"
    },
    {
      "type": "shell",
      "label": "test: tokenizer",
      "command": "node",
      "args": ["test/tokenizer.test.js"],
      "problemMatcher": [],
      "group": "test",
      "detail": "토크나이저 단위 테스트"
    },
    {
      "type": "shell",
      "label": "test: shell",
      "command": "node",
      "args": ["test/shell.test.js"],
      "problemMatcher": [],
      "group": "test",
      "detail": "panel.ts 셸 ↔ test/preview.html 동기화 검사 (브라우저 불필요)"
    },
    {
      "type": "shell",
      "label": "test: ui",
      "command": "node",
      "args": ["test/ui.test.js"],
      "problemMatcher": [],
      "group": "test",
      "detail": "웹뷰 렌더링·상호작용 테스트 (playwright 필요)"
    }
  ]
}
